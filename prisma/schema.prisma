generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum FamilyMemberRole {
  HEAD
  ADULT
  CHILD
}

enum FamilyInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String
  password String?
  role     UserRole @default(USER)
  city     String?

  familyId String?
  family   Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  familyMember FamilyMember?

  passwordResetTokens PasswordResetToken[]

  sentFamilyInvitations FamilyInvitation[] @relation("InvitationSender")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([familyId])
  createdTasks          Task[]          @relation("TaskCreator")
createdCalendarEntries CalendarEntry[] @relation("CalendarEntryCreator")
}

model Family {
  id   String @id @default(cuid())
  name String

  buylistFirebaseUid String? @unique

  members User[]

  familyMembers FamilyMember[]
  invitations   FamilyInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks          Task[]
  calendarEntries CalendarEntry[]
}

model FamilyMember {
  id   String @id @default(cuid())
  name String

  email String?

  role            FamilyMemberRole
  roleDescription String?

  imageUrl String?
  color    String  @default("#E4EBD5")

  joinedAt DateTime @default(now())

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([familyId, role])
  assignedTasks Task[]
}

model FamilyInvitation {
  id String @id @default(cuid())

  email String

  tokenHash String @unique

  status FamilyInvitationStatus @default(PENDING)

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  invitedByUserId String?
  invitedBy       User?   @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, email])
  @@index([familyId, status])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  dueDate     DateTime? @db.Date
  completed   Boolean @default(false)

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   FamilyMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdByUserId String?
  createdBy       User? @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, dueDate])
  @@index([assigneeId])
  @@index([createdByUserId])
}

model CalendarEntry {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  date        DateTime @db.Date
  time        String?

  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User? @relation("CalendarEntryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recurrenceFrequency RecurrenceFrequency?

  @@index([familyId, date])
  @@index([createdByUserId])
}